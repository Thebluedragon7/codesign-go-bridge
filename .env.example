# Where the bridge listens
HOST=127.0.0.1
PORT=8787

# Upstream endpoint (OpenCode Go, OpenAI-compatible API)
UPSTREAM_BASE_URL=https://opencode.ai/inference/go/openai/v1

# Identify this bridge to OpenCode Go. Use an honest, distinct user agent.
USER_AGENT=codesign-go-bridge/0.1.0

# global: one stable session for every project (default)
# project: derive ses_<sha256> from the first user message per project
SESSION_MODE=global

# Optional: pin a stable session so prompt caching survives restarts.
# If unset, a ses_<uuid> is generated once at process start.
# CODESIGN_SESSION_ID=ses_replace-with-a-stable-id

# info | warn | error
LOG_LEVEL=info
